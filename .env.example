# Copy this file to .env in the project root to configure local model options.
# Leave AYURMITRA_OLLAMA_MODEL blank to use extractive grounded RAG.
AYURMITRA_OLLAMA_MODEL=
# Keep interactive answers responsive on CPU; increase this if your model needs more time.
AYURMITRA_OLLAMA_TIMEOUT_SECONDS=45
# Enable only after following docs/MULTILINGUAL_SETUP.md and installing model dependencies.
AYURMITRA_TRANSLATION=off
# Dense retrieval downloads/encodes a multilingual model; enable only when desired.
AYURMITRA_ENABLE_DENSE=0
